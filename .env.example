# Project Settings > API (Supabase). No incluyas nunca la service_role aquí.
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Para proyectos antiguos que solo muestran la anon key, usá esta variable en vez
# de VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=eyJ...

# ID de cobrador a mostrar en el simulador de ruta de campo.
VITE_COBRADOR_ID=1
