# ==========================================
# CREDIT-ON - Variables de Entorno (Vite / Web / Electron)
# ==========================================
# Copie este archivo como .env.local para desarrollo local
# o configure estas variables en el panel de Vercel / Netlify:

# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública 'anon' de Supabase (NUNCA usar 'service_role' aquí)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
